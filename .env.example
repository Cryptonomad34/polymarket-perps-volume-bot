# Polymarket Perps proxy credentials for volume-bot: the file format.
# You normally do NOT need this: `npm run setup` creates the file for you.
# To make one by hand, save it as credentials/proxy-0x<PROXY_ADDRESS>.env (found automatically)
# or point PERPS_ENV_FILE / config.envFile at it. NEVER commit the real file.
#
# The proxy is a separate signing key that your main wallet authorises. It can trade,
# but it cannot withdraw, so your main wallet's private key never touches the bot.

# The main wallet that owns your Polymarket Perps account
POLYMARKET_WALLET_ADDRESS=0xYourMainWalletAddress

# The proxy key pair (the private key must belong to this address)
PERPS_PROXY_ADDRESS=0xYourProxyAddress
PERPS_PROXY_PRIVATE_KEY=0xYourProxyPrivateKey64HexChars

# The secret returned by Polymarket when the proxy was created
PERPS_PROXY_SECRET=your-proxy-secret

# When the proxy expires, in milliseconds since 1970 (e.g. 1767225600000).
# The bot refuses to start live with less than 24 hours left.
PERPS_PROXY_EXPIRES_AT=1767225600000
